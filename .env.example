# Required in production. Development falls back to loony-host / dev-host-secret.
HOST_PASSWORD=
HOST_SECRET=
HOST_EMAIL=

# Public site URL used in emails and Stripe return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres connection string. When unset, the app uses a local Postgres file in .data/.
DATABASE_URL=

# Stripe. When STRIPE_SECRET_KEY is unset, approval creates a local stand-in payment page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend. When unset, emails are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Airbnb calendar export URL so those nights show as taken here.
AIRBNB_ICAL_URL=
